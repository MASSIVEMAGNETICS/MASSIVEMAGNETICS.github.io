{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iambandobandz.com/registry/contracts/lead-ingest.schema.json",
  "title": "Private Lead Ingest Contract",
  "description": "Contract for a future authenticated private ingestion service. This is a schema only; never store submitted PII in the public repository.",
  "type": "object",
  "required": ["source", "submitted_at", "consent_text_version"],
  "properties": {
    "email": {"type": "string", "format": "email"},
    "phone": {"type": "string"},
    "sms_consent": {"type": "boolean"},
    "source": {"type": "string"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "consent_text_version": {"type": "string"},
    "referrer": {"type": "string"}
  },
  "anyOf": [{"required": ["email"]}, {"required": ["phone"]}],
  "additionalProperties": false
}
