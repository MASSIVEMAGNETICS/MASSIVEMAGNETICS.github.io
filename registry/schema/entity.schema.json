{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iambandobandz.com/registry/schema/entity.schema.json",
  "title": "Canonical Entity",
  "type": "object",
  "required": ["id", "type", "name", "status", "canonical_url"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9-]+$"},
    "type": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["active", "planned", "retired"]},
    "canonical_url": {"type": "string", "format": "uri"},
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target"],
        "properties": {"predicate": {"type": "string"}, "target": {"type": "string"}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
