{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iambandobandz.com/registry/schema/receipt.schema.json",
  "title": "Canonical Mutation Receipt",
  "type": "object",
  "required": ["event_id", "timestamp", "actor", "action", "entity_id", "before_sha256", "after_sha256"],
  "properties": {
    "event_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "action": {"type": "string"},
    "entity_id": {"type": "string"},
    "before_sha256": {"type": ["string", "null"]},
    "after_sha256": {"type": "string"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
